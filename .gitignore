# ---------------------------------------------------------------------------
# Video2X Studio 项目特定排除（首个 git 基线）
# ---------------------------------------------------------------------------

# 构建树与产物
build-desktop/
build/
out/

# 前端依赖与构建/打包产物
ui/node_modules/
ui/dist/
ui/release/

# Python 引擎运行时（嵌入式解释器/虚拟环境，体积大、可重建）
engine-python/.venv/
engine-python/python/
# SwiftVR 依赖覆盖层（diffusers 0.36 + decord，pip --target 安装产物）
engine-python/swiftvr-libs/
__pycache__/
*.pyc

# 模型权重（通过内置资产下载系统获取，含国内镜像）
engine-python/weights/
engine-python/downloads/
# 只忽略仓库根的 ncnn 模型目录；不带前导 / 会连 vendor 里的 Python 包 models/ 一起忽略
/models/

# 第三方预编译依赖（ffmpeg/ncnn 等，构建脚本可重新获取）
third_party/

# 运行时缓存与状态（任务队列持久化、暂存文件）
cache/
downloads/
*.log

# macOS 移植
build-macos/
# 打包暂存（scripts/macos/package-app.mjs pre：可重定位的核心与动态库、随包 Python）
/dist-macos/
# 测试素材与参考输出（由迁移包恢复，不进 git）
testdata/
