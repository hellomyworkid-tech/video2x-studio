{
  "name": "video2x-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "bridge": "node server/bridge.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win dir",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "studio.video2x.desktop",
    "productName": "Video2X Studio",
    "asar": false,
    "icon": "build/icon.ico",
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "../build-desktop/Release",
        "to": "build-desktop/Release",
        "filter": ["**/*"]
      },
      {
        "from": "../build-desktop/third_party/boost/libs/program_options/Release",
        "to": "build-desktop/third_party/boost/libs/program_options/Release",
        "filter": ["**/*.dll"]
      },
      {
        "from": "../build-desktop/third_party/spdlog/Release",
        "to": "build-desktop/third_party/spdlog/Release",
        "filter": ["**/*.dll"]
      },
      {
        "from": "../build-desktop/third_party/librealcugan_ncnn_vulkan/src/Release",
        "to": "build-desktop/third_party/librealcugan_ncnn_vulkan/src/Release",
        "filter": ["**/*.dll"]
      },
      {
        "from": "../build-desktop/third_party/librealesrgan_ncnn_vulkan/src/Release",
        "to": "build-desktop/third_party/librealesrgan_ncnn_vulkan/src/Release",
        "filter": ["**/*.dll"]
      },
      {
        "from": "../build-desktop/third_party/librife_ncnn_vulkan/src/Release",
        "to": "build-desktop/third_party/librife_ncnn_vulkan/src/Release",
        "filter": ["**/*.dll"]
      },
      {
        "from": "../third_party/ffmpeg-shared",
        "to": "third_party/ffmpeg-shared",
        "filter": ["**/*"]
      },
      {
        "from": "../third_party/ncnn-shared/x64",
        "to": "third_party/ncnn-shared/x64",
        "filter": ["**/*"]
      },
      {
        "from": "../models",
        "to": "models",
        "filter": ["**/*"]
      },
      {
        "from": "../engine-python",
        "to": "engine-python",
        "filter": [
          "**/*",
          "!.venv/**",
          "!**/__pycache__/**",
          "!weights/FlashVSR-v1.1/**",
          "!python/Lib/site-packages/torch/include/**",
          "!python/Lib/site-packages/*/tests/**",
          "!python/Lib/site-packages/*/test/**",
          "!python/Lib/site-packages/imageio/**",
          "!python/Lib/site-packages/imageio_ffmpeg/**",
          "!python/Lib/site-packages/modelscope/**",
          "!python/Lib/site-packages/modelscope_hub/**",
          "!python/Lib/site-packages/matplotlib/**",
          "!python/Lib/site-packages/mpl_toolkits/**",
          "!python/Lib/site-packages/fontTools/**",
          "!python/Lib/site-packages/hf_xet/**",
          "!python/Lib/site-packages/pip/**",
          "!python/Lib/site-packages/setuptools/**"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "../WEIGHTS_LICENSES.md",
        "to": "WEIGHTS_LICENSES.md"
      },
      {
        "from": "../SOURCE.txt",
        "to": "SOURCE.txt"
      },
      {
        "from": "../COMPLIANCE.md",
        "to": "COMPLIANCE.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Video2X-Studio-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "react-resizable-panels": "^4.2.2",
    "react-router": "^7.6.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
